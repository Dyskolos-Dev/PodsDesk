el><StackPanel x:Name="HelpPage" Visibility="Collapsed"><TextBlock x:Name="HelpEyebrow" Text="BESOIN D’UN COUP DE MAIN ?" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/><TextBlock x:Name="HelpTitle" Text="Aide" FontSize="29" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="HelpSubtitle" Text="Les réponses aux questions courantes." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,25"/><Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock x:Name="HelpQuestion1" Text="Mes batteries ne s’affichent pas" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="HelpAnswer1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/><Border Height="1" Background="{DynamicResource Stroke}" Margin="0,18,0,18"/><TextBlock x:Name="HelpQuestion2" Text="Pourquoi les pourcentages sont-ils approximatifs ?" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HelpAnswer2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/><Border Height="1" Background="{DynamicResource Stroke}" Margin="0,18,0,18"/><TextBlock x:Name="HelpQuestion3" Text="L’application continue après la fermeture" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HelpAnswer3" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Border></StackPanel><StackPanel x:Name="Settings" Visibility="Collapsed"><TextBlock x:Name="SettingsEyebrow" Text="PERSONNALISATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/><TextBlock x:Name="SettingsTitle" Text="Paramètres" FontSize="29" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="SettingsSubtitle" Text="Une expérience qui vous ressemble." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,5,0,25"/><Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock x:Name="AppearanceLabel" Text="APPARENCE" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="10"/><ComboBox x:Name="Theme" Margin="0,9,0,20" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Clair"/><ComboBoxItem Content="Sombre"/></ComboBox><TextBlock x:Name="LanguageLabel" Text="LANGUE" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="10"/><ComboBox x:Name="LanguagePicker" Margin="0,9,0,20" SelectionChanged="LanguageChanged"><ComboBoxItem Content="Français"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Español"/><ComboBoxItem Content="Deutsch"/><ComboBoxItem Content="Português"/></ComboBox><Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,17"/><CheckBox x:Name="NotificationsToggle" Content="Alerte de batterie faible" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,13" Click="PreferencesChanged"/><TextBlock x:Name="ThresholdLabel" Text="SEUIL DE L’ALERTE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="20,0,0,7"/><ComboBox x:Name="Threshold" Width="150" HorizontalAlignment="Left" Margin="20,0,0,18" SelectionChanged="ThresholdChanged"><ComboBoxItem Content="10 %"/><ComboBoxItem Content="20 %"/><ComboBoxItem Content="30 %"/><ComboBoxItem Content="40 %"/></ComboBox><CheckBox x:Name="StartupToggle" Content="Démarrer avec Windows" Foreground="{DynamicResource Text}" FontSize="13" Click="StartupChanged"/><TextBlock x:Name="StartupHint" Text="L’application démarre discrètement dans la zone de notification." Foreground="{DynamicResource Muted}" FontSize="11" Margin="20,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="AboutLabel" Text="À PROPOS" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="PodsDesk" FontSize="18" FontWeight="Bold" Margin="0,9,0,2"/><TextBlock x:Name="Credit" Text="Un projet de Dyskolos_" Foreground="{DynamicResource Muted}"/>