<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0"><DockPanel Margin="20,27,20,22"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="3,0,0,40"><Image Source="Assets/PodsDesk-logo.png" Width="45" Height="45" Stretch="Uniform"/><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="PodsDesk" FontSize="17" FontWeight="Bold"/><TextBlock Text="WINDOWS COMPANION" FontSize="9" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel><TextBlock x:Name="NavTag" Text="ESPACE PERSONNEL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="13,0,0,10"/><Button x:Name="HomeButton" Style="{StaticResource NavButton}" Content="◉    Vue d’ensemble" Click="ShowHome"/><Button x:Name="BatteryButton" Style="{StaticResource NavButton}" Content="▣    Batterie" Click="ShowBattery"/><Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Content="⚙    Paramètres" Click="ShowSettings"/><Button x:Name="HelpButton" Style="{StaticResource NavButton}" Content="?    Aide" Click="ShowHelp"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Background="{DynamicResource Inset}" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="PodsDesk" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="SidebarNote" Text="Votre audio, simplement." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="VERSION  ·  1.0" FontSize="10" Foreground="{DynamicResource Muted}" Margin="12,18,0,0"/></StackPanel></DockPanel></Border>
